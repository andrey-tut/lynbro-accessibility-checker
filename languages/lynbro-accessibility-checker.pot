msgstr ""

#: includes/lynbro-core/lynbro-core.php:1409
msgid "the site is set up for Denmark"
msgstr ""

#: includes/lynbro-core/lynbro-core.php:1410
msgid "comments are open"
msgstr ""

#: includes/lynbro-core/lynbro-core.php:1411
msgid "tracking tags are active"
msgstr ""

#: includes/lynbro-core/lynbro-core.php:1412
msgid "visitors can create accounts"
msgstr ""

#: includes/lynbro-core/lynbro-core.php:1421
