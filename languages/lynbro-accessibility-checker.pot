msgstr ""

#: includes/lynbro-core/lynbro-core.php:1349
msgid "Maybe later"
msgstr ""

#: includes/lynbro-core/lynbro-core.php:1350
msgid "Don't ask again"
msgstr ""

#: includes/lynbro-core/lynbro-core.php:1353
msgid "Something not working? Ask for help"
msgstr ""

